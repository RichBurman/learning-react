 import React from 'react';
import { createRoot } from 'react-dom/client';

const container = document.getElementById('app');
const root = createRoot(container);
function coinToss () {
  // Randomly return either 'heads' or 'tails'.
  return Math.random() < 0.5 ? 'heads' : 'tails';
}

const pics = {
  kitty: 'https://content.codecademy.com/courses/React/react_photo-kitty.jpg',
  doggy: 'https://content.codecademy.com/courses/React/react_photo-puppy.jpeg'
};

const img = <img src={pics[coinToss() === 'heads' ? 'kitty' : 'doggy']} />;

<!-- The square brackets [] are used for accessing a value in an object by key. 
In this code, pics is an object with keys 'kitty' and 'doggy'. 
The expression inside the brackets picks which key to use based on the result of the ternary operator.

For example, if the result is 'kitty', then pics['kitty'] gives the kitty image URL. 
If the result is 'doggy', then pics['doggy'] gives the doggy image URL. This is called bracket notation. 
-->
root.render(img);